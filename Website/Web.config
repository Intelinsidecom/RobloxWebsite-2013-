<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Roblox.WebsiteSettings.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="Roblox.Configuration.Properties.EnvironmentSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <section name="robloxConfigurationProvider" type="Roblox.Configuration.ProviderConfigSection, Roblox.Configuration" requirePermission="false" />
  </configSections>
  <robloxConfigurationProvider configSource="App_Data\Configuration\Roblox.Configuration.config" />
  <appSettings>
    <add key="FastStartup" value="false" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.6.1" />
      </system.Web>
  -->
  <system.web>
    <compilation debug="true" batch="false" optimizeCompilations="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
      <buildProviders>
        <add extension=".cshtml" type="System.Web.WebPages.Razor.RazorBuildProvider, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add extension=".vbhtml" type="System.Web.WebPages.Razor.RazorBuildProvider, System.Web.WebPages.Razor, Version=3.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </buildProviders>
    </compilation>
    <httpRuntime targetFramework="4.7.2" />
    <pages clientIDMode="AutoID" controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="Roblox.Website" />
        <add namespace="Roblox.Controls" />
        <add namespace="Roblox.Web.Code" />
      </namespaces>
    </pages>
    <customErrors mode="Off" defaultRedirect="~/RobloxDefaultErrorPage.aspx">
      <error statusCode="400" redirect="~/RobloxDefaultErrorPage.aspx?code=400" />
      <error statusCode="403" redirect="~/RobloxDefaultErrorPage.aspx?code=403" />
      <error statusCode="404" redirect="~/RobloxDefaultErrorPage.aspx?code=404" />
      <error statusCode="500" redirect="~/RobloxDefaultErrorPage.aspx?code=500" />
    </customErrors>
    <authentication configSource="App_Data\Configuration\Roblox.Authentication.config" />
    <machineKey configSource="App_Data\Configuration\machinekey.config" />
    <membership defaultProvider="RobloxMembershipProvider">
      <providers>
        <clear />
        <add name="RobloxMembershipProvider" type="Roblox.Website.Providers.RobloxMembershipProvider" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="false" maxInvalidPasswordAttempts="5" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="0" passwordAttemptWindow="10" applicationName="RobloxWebSite" />
      </providers>
    </membership>
    <roleManager enabled="true" defaultProvider="RobloxRoleProvider">
      <providers>
        <add name="RobloxRoleProvider" type="Roblox.Website.Providers.RobloxRoleProvider" applicationName="RobloxWebSite" />
      </providers>
    </roleManager>
    <siteMap>
      <providers>
        <add name="RobloxSiteMapProvider" description="SiteMap provider which reads in .sitemap text files." type="System.Web.XmlSiteMapProvider" siteMapFile="Web.Sitemap" />
      </providers>
    </siteMap>
  </system.web>
  <location path="Admi">
    <system.web>
      <authorization>
        <allow roles="SuperAdministrator, Developer" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <urlCompression doDynamicCompression="true" doStaticCompression="true" />
    <httpErrors existingResponse="PassThrough" />
    <handlers>
      <!-- Ensure extensionless URLs are passed to ASP.NET pipeline (MVC) in Integrated pipeline mode -->
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0"
           path="*."
           verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
      <!-- Allow default ASP.NET handler mappings (PageHandlerFactory, etc.) to handle .aspx/.ashx/.asmx -->
    </handlers>
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" />
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="image/*" enabled="false" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="UrlRoutingModule-4.0" />
      <add name="UrlRoutingModule-4.0" type="System.Web.Routing.UrlRoutingModule" preCondition="" />
      <add name="CookieConstraintModule" type="Roblox.Web.Code.CookieConstraint.CookieConstraintModule, Roblox.Website" />
    </modules>
    <!-- Use default handler mappings; UrlRoutingModule will route extensionless URLs in Integrated pipeline -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <remove fileExtension=".ico" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
    </staticContent>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="true" />
      </requestFiltering>
    </security>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
  <applicationSettings>
    <Roblox.Configuration.Properties.EnvironmentSettings configSource="App_Data\Configuration\Roblox.Configuration.Properties.EnvironmentSettings.config" />
  </applicationSettings>
