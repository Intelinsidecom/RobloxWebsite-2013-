<Project>
  <ItemGroup>
    <!-- Unify package versions across all Assemblies/* projects to prevent NU1605 downgrades -->
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="7.0.0" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageVersion Include="System.Resources.Extensions" Version="7.0.0" />
    <PackageVersion Include="AWSSDK.Core" Version="3.7.500.17" />
  </ItemGroup>
</Project>
